{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["chrome"],
    "lib": ["ES2020", "DOM"]
  },
  "include": ["background", "content-scripts", "popup"]
}
