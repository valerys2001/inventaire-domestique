# Copiez ce fichier en .env.local (ignoré par git) et complétez les deux valeurs.

# OAuth 2.0 Client ID (type "Application Web") créé dans Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=

# ID du Google Sheet partagé (dans son URL : https://docs.google.com/spreadsheets/d/<ID>/edit)
VITE_SPREADSHEET_ID=
